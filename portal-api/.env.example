# Server
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/biodao?schema=public"

# OpenAI API
OPENAI_API_KEY="sk-your-openai-api-key"

# Discord Bot configuration
DISCORD_BOT_TOKEN="your_discord_bot_token"
DISCORD_CLIENT_ID="your_discord_application_client_id"

# API URL for callbacks
API_URL="http://localhost:3001"

# NFT Minting Configuration
NFT_MINTER_PRIVATE_KEY=your_private_key_here
# Set to 'true' to enable real blockchain minting, 'false' for simulation mode
ENABLE_REAL_MINTING=false

# OpenAI API key for NFT image generation
OPENAI_API_KEY=your_openai_api_key_here 